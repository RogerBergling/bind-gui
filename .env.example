# Optional password protection for the whole BIND Workbench.
# Leave empty for the default local-only, no-password setup.
# Docker Compose reads this file; start.py also loads ./.env automatically.
#
# Generate a strong value:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BIND_WORKBENCH_PASSWORD=
# Optional second password just before configuration files are imported.
# If empty, it falls back to BIND_WORKBENCH_PASSWORD when that is set.
BIND_WORKBENCH_UPLOAD_PASSWORD=
BIND_WORKBENCH_SESSION_HOURS=12
